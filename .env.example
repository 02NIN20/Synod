DASHSCOPE_API_KEY=your_api_key_here
# Model for general/chat completions and non-JSON agents
QWEN_MODEL=qwen3.6-plus-2026-04-02
# Model for agents that require strict JSON output (Cartographer, Inspector, Sentinel, Smith)
QWEN_AGENT_MODEL=qwen3-coder-next

# GitHub integration (optional)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# GITHUB_MAX_FILES_PER_PR=10
# GITHUB_MAX_FILE_LINES=500
